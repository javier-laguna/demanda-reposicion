# Copia este archivo a .env (nunca se versiona) y completa solo lo que uses.

# Proveedor LLM en notación de Pydantic AI (proveedor:modelo). Sin key, el tablero usa la caché de insights
# del repo o, si no coincide con los artefactos, conclusiones generadas con plantillas.
LLM_MODEL=anthropic:claude-sonnet-5-5
# Gateway compatible con la API de OpenAI (corporativo, OpenRouter, vLLM), si aplica.
# LLM_BASE_URL=

ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Rutas (por defecto, data/ y artifacts/ en la raíz del repo)
# DATA_DIR=data
# ARTIFACTS_DIR=artifacts
# MLflow (por defecto, sqlite en artifacts/mlflow.db). No se usa MLFLOW_TRACKING_URI a propósito.
# DEMANDA_MLFLOW_TRACKING_URI=
