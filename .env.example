# Copia este archivo a .env (nunca se versiona) y completa solo lo que uses.

# Proveedor LLM en notación de Pydantic AI (proveedor:modelo): anthropic, openrouter u openai. Sin key,
# `make insights` usa la caché de insights del repo o, si no coincide con los artefactos, conclusiones
# generadas con plantillas.
LLM_MODEL=anthropic:claude-opus-5-5
# Con el proveedor openai: un gateway compatible con su API (corporativo, vLLM), si aplica.
# LLM_BASE_URL=

ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Freno de gasto propio, en USD estimados (el límite duro va en la consola del proveedor):
# el modo vivo no arranca si el acumulado de artifacts/insights/gasto.json llega al presupuesto,
# y una corrida se corta al pasar su tope.
# LLM_PRESUPUESTO_USD=20
# LLM_TOPE_CORRIDA_USD=1

# Rutas (por defecto, data/ y artifacts/ en la raíz del repo)
# DATA_DIR=data
# ARTIFACTS_DIR=artifacts
# MLflow (por defecto, sqlite en artifacts/mlflow.db). No se usa MLFLOW_TRACKING_URI a propósito.
# DEMANDA_MLFLOW_TRACKING_URI=
